# Public URL users open in their browser, without a trailing slash.
SUBTOOLS_PUBLIC_ORIGIN=https://subtools.example.com
# Only needed on a fresh server with no data/admin.json or initial-password.txt.
# Set a unique password of at least 12 characters. Remove after initialization.
SUBTOOLS_ADMIN_PASSWORD=

# Batch size, decrypted history cache, successful-task archive age (0 disables).
SUBTOOLS_MAX_ACCOUNTS=200
SUBTOOLS_TASK_CACHE=20
SUBTOOLS_ARCHIVE_DAYS=30
# Budgets shared by all admin sessions. Status polling/stop are not throttled.
SUBTOOLS_SUBMITS_PER_MINUTE=12
SUBTOOLS_QUERIES_PER_MINUTE=60
SUBTOOLS_IMPORTS_PER_MINUTE=300
# Leave room for Chromium and the host OS; adjust to your server capacity.
SUBTOOLS_CPU_LIMIT=2.0
SUBTOOLS_MEMORY_LIMIT=3g
